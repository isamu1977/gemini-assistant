{
  "manifest_version": 3,
  "name": "Gemini Assistant",
  "version": "0.9.10",
  "description": "Generic project and task manager for gemini.google.com. v0.8.0: full single-task workflow (Prepare Task -> User Review -> Generate Task -> Detect Result -> Download -> Rename -> Complete).",
  "minimum_chrome_version": "116",

  "permissions": ["storage", "sidePanel", "downloads"],

  "host_permissions": [
    "https://gemini.google.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_title": "Open Gemini Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["src/dom/geminiDomAdapter.js", "src/content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icons/*"],
      "matches": ["https://gemini.google.com/*"]
    }
  ]
}
